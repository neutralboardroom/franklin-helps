CSS_OVERRIDE='/* FH-MAIN-0.1.18 owner live-screen review: hierarchy, density and scanability. */
html{scroll-padding-top:110px}
[id]{scroll-margin-top:110px}
.hero{padding-top:46px;padding-bottom:42px;gap:30px}
.hero h1{font-size:clamp(2.45rem,5.2vw,4.45rem);line-height:1.01}
.hero .lede{font-size:1.12rem}
.section{padding-top:46px;padding-bottom:46px}
.section h1,.section h2{font-size:clamp(1.9rem,3.35vw,3.05rem);line-height:1.08}
.home-brand-lockup{width:min(360px,74vw);margin-bottom:12px}
.today-grid{margin-top:18px;gap:14px}.today-grid article{padding:19px}.today-grid h3{font-size:1.32rem;margin:10px 0 7px}
.status-text{margin:6px 0 10px;color:var(--muted);font-weight:760;font-size:.9rem;line-height:1.35}
.story-grid.three{gap:14px}.story-step{padding:19px}.story-step .number{font-size:1.65rem}
.trust-strip{margin-bottom:8px}.trust-strip div{padding:14px 16px}.trust-strip span{font-size:.82rem}
.card,.resource,.status-card{padding:18px}.grid2,.grid3{gap:14px}
.resources{gap:12px;margin-top:18px}.resource{min-height:0}.resource h3{margin:10px 0 8px}.resource p{margin-top:5px;margin-bottom:8px}.resource .meta{font-size:.8rem;margin-bottom:5px}.resource-actions{padding-top:8px}
.freshness.plain-status{padding:0;border:0;background:transparent!important;text-transform:none;letter-spacing:0;color:var(--muted);font-size:.78rem}
.resource-search{max-width:900px;margin:18px 0}.resource-search input{max-width:760px}
.filters{margin:12px 0 14px}.filter{padding:8px 11px}
.relationship-note{margin:12px 0 16px;padding:8px 0;background:transparent;border-left:0;border-radius:0;font-size:.9rem;box-shadow:none}
.urgent-help{margin:16px 0;padding:16px}.urgent-grid a{min-height:88px;padding:14px}
.correction-cta{margin-top:20px;margin-bottom:18px;padding:18px 20px}.correction-cta p{