margin-bottom:6px}
.compact-choice-grid{margin-top:18px}
.footer{margin-top:8px}.footer-inner{padding:18px 22px;gap:12px}.footer-utility-nav{max-width:var(--max);margin:0 auto;padding:0 22px 18px;gap:2px 14px}.footer-utility-nav a{min-height:34px;padding:5px 0}
@media(max-width:760px){html{scroll-padding-top:96px}[id]{scroll-margin-top:96px}.hero{padding-top:34px;padding-bottom:34px}.section{padding-top:38px;padding-bottom:38px}.home-brand-lockup{width:min(320px,86vw)}.section h1,.section h2{font-size:clamp(1.8rem,9vw,2.7rem)}}
@media(max-width:420px){.hero h1{font-size:clamp(2.05rem,11vw,2.75rem)}.section{padding-top:34px;padding-bottom:34px}.card,.resource,.status-card{padding:16px}}
